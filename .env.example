# Bu dosya SADECE ÖRNEKTİR. Gerçek değerleri ".env" adlı (gitignore'da olan)
# bir dosyaya kopyalayın; ".env" dosyasını ASLA paylaşmayın veya commit etmeyin.
#
# Sepolia RPC adresi (Alchemy, Infura veya herhangi bir public RPC sağlayıcı)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/KENDI_PROJE_ID_NIZ

# SADECE test amaçlı, test ETH dışında hiçbir değeri olmayan bir cüzdanın
# private key'i. GERÇEK PARA / mainnet cüzdanınızın anahtarını ASLA buraya
# yazmayın.
PRIVATE_KEY=0xYOUR_TESTNET_ONLY_PRIVATE_KEY

# Etherscan "Verify" işlemi için API anahtarı (etherscan.io -> My API Keys)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
